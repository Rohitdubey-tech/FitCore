# Server
NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/fitcore
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Auth & Security (Change in production)
JWT_ACCESS_SECRET=replace_with_64_char_random_access_secret_key_for_fitcore_dev
JWT_REFRESH_SECRET=replace_with_64_char_random_refresh_secret_key_for_fitcore_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Web Frontend
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Mobile App
EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api/v1

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Integrations (Optional in local dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fitcore.app
